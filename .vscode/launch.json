{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: a second VS Code window with the extension loaded and the samples open.
      // Build first: `dotnet build Bamen.slnx`, then `npm install` and `npm run build` in editors/vscode.
      "name": "Run Bamen extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/samples"
      ]
    }
  ]
}